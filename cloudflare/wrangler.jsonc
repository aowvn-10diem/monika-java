{
  // Cấu hình tham khảo cho `wrangler deploy` / `wrangler dev`. Bản đang chạy được triển khai qua API (xem README).
  "name": "monika-api",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "API_HOST": "api.justmonika.top", "BLOG_URL": "https://m.justmonika.top",
            "GH_REPO": "aowvn-10diem/monika-java", "GH_BRANCH": "files", "GH_DIR": "jars",
            "CF_ACCOUNT_ID": "7e8158c75c09fedc35134996ada34204",
            "FB_TO": "vuminh2612@gmail.com", "FB_FROM": "gopy@justmonika.top" },
  "d1_databases": [{ "binding": "DB", "database_name": "monika", "database_id": "bc819f19-65b8-4528-938b-2e17833ba180" }],
  // R2: kho file chính (JAR) và ảnh minh họa (khóa pic/<tên>.jpg, phát qua /v1/pic/<tên>.jpg). PHẢI tạo bucket monika-files trước khi deploy, nếu không deploy báo lỗi.
  "r2_buckets": [{ "binding": "R2", "bucket_name": "monika-files" }],
  // KV FILES: kho dự phòng cuối (R2 → GitHub → KV).
  "kv_namespaces": [{ "binding": "FILES", "id": "3ee1a3e5a96247f0a93987b9fde8e800" }],
  // Chặn tải/tìm kiếm dồn dập theo IP (xấp xỉ, mỗi trung tâm dữ liệu một bộ đếm). Không khai thì code bỏ qua.
  "ratelimits": [
    { "name": "RL_DL", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } },
    { "name": "RL_SEARCH", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_FB", "namespace_id": "1003", "simple": { "limit": 3, "period": 60 } }
  ],
  // Gửi email tổng hợp góp ý cho FB_TO (Cloudflare Email Service). Chỉ gửi được tới địa chỉ đã xác minh trong Email Routing > Destination addresses, và FB_FROM phải thuộc miền đã Onboard ở Email Sending.
  "send_email": [{ "name": "EMAIL", "destination_address": "vuminh2612@gmail.com" }]
  // Chốt chặn hạn mức free (r2guard.js). Mặc định: lưu trữ 10GB, Class A 1 triệu/tháng, Class B 10 triệu/tháng, D1 100k hàng ghi/ngày, Worker 100k lượt/ngày; cảnh báo 80%, khóa 90%.
  // Biến tùy chọn: R2_STORAGE_LIMIT, R2_A_LIMIT, R2_B_LIMIT, D1_WRITE_LIMIT, REQ_LIMIT (số), R2_WARN_PCT, R2_LOCK_PCT; ALERT_URL (secret hoặc biến, webhook Discord/Telegram nhận JSON {text, content});
  // CF_ACCOUNT_ID + secret CF_API_TOKEN (quyền Account Analytics:Read và Workers R2 Storage:Read) để lấy số thật từ Cloudflare mỗi 25 phút. Không có thì chỉ đếm trong Worker (D1/Worker không có số).
  // Secret: FB_SECRET (tùy chọn, khóa ký captcha góp ý; mặc định UP_TOKEN), RESEND_KEY (tùy chọn, kênh gửi email dự phòng), SYNC_TOKEN, UP_TOKEN, GH_TOKEN (tùy chọn, quyền Contents: write), DL_SALT (tùy chọn, muối băm khóa đếm lượt tải; mặc định lấy UP_TOKEN)
  // Biến tùy chọn: REF_OK = danh sách host được phép trỏ link tải (ngoài host của mình), cách nhau bằng dấu phẩy
}
